# Token largo y secreto para el panel (/admin) y el modo presentador (/deck?token=...)
# Genera uno seguro con: openssl rand -hex 24
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# A dónde manda el botón "Entrar a CodexSoto" después del registro
PLATFORM_URL=https://codexsoto.com

# Enlace a tu aviso de privacidad (aparece en el checkbox del formulario de registro)
# Recomendado: LFPDPPP (Ley Federal de Protección de Datos Personales en Posesión de Particulares)
# Ejemplo: https://codexsoto.com/privacidad
PRIVACY_URL=

# Nombre del evento (aparece en la app)
EVENT_NAME=Agentes de IA 2026
